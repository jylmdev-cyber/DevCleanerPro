<Page x:Class="DevCleanerPro.Views.Pages.ShadowCopyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Shadow Copies">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Shadow Copies" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Gestiona puntos de restauración del sistema" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="Cargar" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Click="BtnLoad_Click" Margin="0,0,8,0"/><ui:Button Content="Eliminar seleccionado" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnDelete_Click" Margin="0,0,8,0"/><ui:Button Content="Eliminar TODOS" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnDeleteAll_Click" Margin="0,0,8,0"/><ui:Button Content="Abrir configuración" Icon="{ui:SymbolIcon Settings24}" Click="BtnOpenRestore_Click"/></StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="300"/><DataGridTextColumn Header="Volumen" Binding="{Binding Volume}" Width="200"/><DataGridTextColumn Header="Fecha" Binding="{Binding InstallDate, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
        </DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/><TextBlock x:Name="TxtStatus" Grid.Column="1" Foreground="{DynamicResource DevTextMuted}" FontSize="12" VerticalAlignment="Center"/></Grid>
    </Grid>
</Page>
