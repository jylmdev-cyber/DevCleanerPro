<Page x:Class="DevCleanerPro.Views.Pages.AuditLogPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Historial">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Historial de Auditoría" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Registro de todas las acciones de limpieza" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="Hoy" Icon="{ui:SymbolIcon Calendar24}" Appearance="Primary" Click="BtnToday_Click" Margin="0,0,8,0"/><ui:Button Content="Última semana" Icon="{ui:SymbolIcon CalendarWeekNumbers24}" Click="BtnWeek_Click" Margin="0,0,8,0"/><ui:Button Content="Exportar CSV" Icon="{ui:SymbolIcon ArrowDownload24}" Click="BtnExport_Click" Margin="0,0,8,0"/><ui:Button Content="Purgar >30 días" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnPurge_Click"/></StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Fecha" Binding="{Binding Timestamp, StringFormat=dd/MM HH:mm:ss}" Width="140"/><DataGridTextColumn Header="Módulo" Binding="{Binding Module}" Width="180"/><DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="200"/><DataGridTextColumn Header="Liberados" Binding="{Binding BytesFreed, StringFormat=N0}" Width="120"/><DataGridTextColumn Header="Archivos" Binding="{Binding FilesDeleted}" Width="80"/><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="80"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Foreground="{DynamicResource DevTextMuted}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</Page>
