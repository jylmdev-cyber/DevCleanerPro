<Page x:Class="DevCleanerPro.Views.Pages.FirewallAuditPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Firewall">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Firewall Audit" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Auditoría de reglas del Firewall de Windows" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="Cargar reglas" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnLoad_Click" Margin="0,0,8,0"/><ui:Button Content="Buscar huérfanos" Icon="{ui:SymbolIcon Warning24}" Appearance="Caution" Click="BtnOrphans_Click" Margin="0,0,8,0"/><ui:Button Content="Exportar CSV" Icon="{ui:SymbolIcon ArrowDownload24}" Click="BtnExport_Click"/></StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Dirección" Binding="{Binding Direction}" Width="100"/><DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="80"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding Enabled}" Width="70"/>
        </DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/><TextBlock x:Name="TxtStatus" Grid.Column="1" Foreground="{DynamicResource DevTextMuted}" FontSize="12" VerticalAlignment="Center"/></Grid>
    </Grid>
</Page>
