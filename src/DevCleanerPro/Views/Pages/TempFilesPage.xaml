<Page x:Class="DevCleanerPro.Views.Pages.TempFilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Temporales">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Archivos Temporales" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Temp del sistema, Windows Update, crash dumps, prefetch y más" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="TxtCatCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    <TextBlock Text="Categorías" Style="{StaticResource StatLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="TxtTotalSize" Text="0 B" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource DevAccentBlue}"/>
                    <TextBlock Text="Tamaño total" Style="{StaticResource StatLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button x:Name="BtnAnalyze" Content="Analizar" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnAnalyze_Click" Margin="0,0,8,0" ToolTip="Escanea sin eliminar nada (F5 para refrescar)"/>
                        <ui:Button x:Name="BtnClean" Content="Limpiar" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnClean_Click" IsEnabled="False" ToolTip="Elimina los archivos seleccionados"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Data Grid -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="TempGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="200" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Archivos" Binding="{Binding FileCount}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource FileSizeColorConverter}}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,6"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty State -->
            <Border x:Name="EmptyState" Background="{DynamicResource DevBgSurface}" CornerRadius="8" BorderBrush="{DynamicResource DevBorder}" BorderThickness="1"
                    Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="48,36">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search24" FontSize="48" Foreground="{DynamicResource DevTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Sin resultados" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource DevTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Pulsa &quot;Analizar&quot; para escanear archivos temporales" FontSize="13" Foreground="{DynamicResource DevTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ui:Button Content="Analizar ahora" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnAnalyze_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Listo para analizar" VerticalAlignment="Center" Foreground="{DynamicResource DevTextMuted}" FontSize="12"/>
        </Grid>
    </Grid>
</Page>
