<Page x:Class="DevCleanerPro.Views.Pages.AiAgentCleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="AI Agent Cleaner">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="AI Agent Cleaner" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Limpia cachés, logs, modelos e historial de 10 herramientas de IA" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- Stat Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Total detectado" Style="{StaticResource StatLabelStyle}"/><TextBlock x:Name="TxtTotal" Text="—" Style="{StaticResource StatValueStyle}"/></StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DevAccentBlueDim}">
                        <ui:SymbolIcon Symbol="Search24" Foreground="{DynamicResource DevAccentBlue}" FontSize="20"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="4,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Seguro eliminar" Style="{StaticResource StatLabelStyle}"/><TextBlock x:Name="TxtSafe" Text="—" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource DevAccentGreen}"/></StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DevAccentGreenDim}">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="{DynamicResource DevAccentGreen}" FontSize="20"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="4,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Requiere confirmación" Style="{StaticResource StatLabelStyle}"/><TextBlock x:Name="TxtUnsafe" Text="—" Style="{StaticResource StatValueStyle}" Foreground="{DynamicResource DevAccentOrange}"/></StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DevAccentOrangeDim}">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource DevAccentOrange}" FontSize="20"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="4,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Herramientas" Style="{StaticResource StatLabelStyle}"/><TextBlock x:Name="TxtToolCount" Text="—" Style="{StaticResource StatValueStyle}"/></StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DevAccentPurpleDim}">
                        <ui:SymbolIcon Symbol="Apps24" Foreground="{DynamicResource DevAccentPurple}" FontSize="20"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="Escanear" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnScan_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Seleccionar seguros" Icon="{ui:SymbolIcon CheckmarkCircle24}" Click="BtnSelectSafe_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Seleccionar huérfanos" Icon="{ui:SymbolIcon Warning24}" Click="BtnSelectOrphans_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Deseleccionar todo" Icon="{ui:SymbolIcon DismissCircle24}" Click="BtnDeselectAll_Click" Margin="0,0,8,0"/>
            <ui:Button x:Name="BtnClean" Content="Limpiar seleccionados" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnClean_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Tabs: Items + Models -->
        <TabControl Grid.Row="3">
            <!-- Tab Cachés/Logs -->
            <TabItem Header="Cachés y Logs">
                <Grid>
                    <Border x:Name="PanelEmptyState" Style="{StaticResource StatCardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="48,32">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Search24" FontSize="48" Margin="0,0,0,16" HorizontalAlignment="Center" Foreground="{DynamicResource DevAccentBlue}"/>
                            <TextBlock Text="Listo para analizar" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pulse Escanear para buscar cachés de IA" Opacity="0.6" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="GridItems" Visibility="Collapsed" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="Herramienta" Binding="{Binding ToolName}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource FileSizeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Seguro" Binding="{Binding IsSafe}" Width="65" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Huérfano" Binding="{Binding IsOrphan}" Width="75" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <!-- Tab Modelos LLM -->
            <TabItem Header="Modelos LLM">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="GridModels" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="100"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="100"/>
                            <DataGridTextColumn Header="Cuantización" Binding="{Binding Quantization}" Width="100"/>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource FileSizeColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Último acceso" Binding="{Binding LastAccessed, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Comando" Binding="{Binding CliCommand}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:Button Grid.Row="1" Content="Eliminar modelo seleccionado" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnDeleteModel_Click" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
            <!-- Tab Herramientas detectadas -->
            <TabItem Header="Herramientas detectadas">
                <DataGrid x:Name="GridTools" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Herramienta" Binding="{Binding Name}" Width="150"/>
                        <DataGridCheckBoxColumn Header="En ejecución" Binding="{Binding IsRunning}" Width="100"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalSize, Converter={StaticResource FileSizeConverter}}" Width="120"/>
                        <DataGridTextColumn Header="Seguro" Binding="{Binding SafeSize, Converter={StaticResource FileSizeConverter}}" Width="120"/>
                        <DataGridTextColumn Header="Requiere confirm." Binding="{Binding UnsafeSize, Converter={StaticResource FileSizeConverter}}" Width="120"/>
                        <DataGridTextColumn Header="Modelos" Binding="{Binding ModelCount}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Foreground="{DynamicResource DevTextMuted}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
