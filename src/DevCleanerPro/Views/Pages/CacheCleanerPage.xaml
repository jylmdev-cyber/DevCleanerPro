<Page x:Class="DevCleanerPro.Views.Pages.CacheCleanerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Cachés">
    <Grid Margin="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Limpiador de Cachés" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="NuGet, npm, Yarn, pip, Gradle, Maven, Go, Cargo, Composer y más" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="TxtCacheCount" Text="0" Style="{StaticResource StatValueStyle}"/>
                    <TextBlock Text="Cachés detectadas" Style="{StaticResource StatLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <TextBlock x:Name="TxtTotalSize" Text="0 B" Style="{StaticResource StatValueStyle}"/>
                    <TextBlock Text="Tamaño total" Style="{StaticResource StatLabelStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:Button x:Name="BtnAnalyze" Content="Analizar" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnAnalyze_Click" Margin="0,0,8,0"/>
                        <ui:Button x:Name="BtnClean" Content="Limpiar" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnClean_Click" IsEnabled="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <DataGrid x:Name="CacheGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="250" IsReadOnly="True"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ruta" Binding="{Binding Path}" Width="250" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tamaño" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource FileSizeColorConverter}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,6"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Pulse Analizar para detectar cachés" VerticalAlignment="Center" Foreground="{DynamicResource DevTextMuted}" FontSize="12"/>
        </Grid>
    </Grid>
</Page>
