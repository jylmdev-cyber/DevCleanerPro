<Page x:Class="DevCleanerPro.Views.Pages.DiskAnalyzerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Disco">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Analizador de Disco" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Encuentra los 50 archivos más grandes" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtPath" PlaceholderText="Seleccione carpeta..." Margin="0,0,8,0"/><ui:Button Grid.Column="1" Content="Examinar" Click="BtnBrowse_Click" Margin="0,0,8,0"/><ui:Button Grid.Column="2" x:Name="BtnScan" Content="Escanear" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Click="BtnScan_Click"/></Grid>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Archivo" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Tamaño" Binding="{Binding Size, StringFormat=N0}" Width="120"/><DataGridTextColumn Header="Extensión" Binding="{Binding Extension}" Width="80"/><DataGridTextColumn Header="Modificado" Binding="{Binding LastModified, StringFormat=dd/MM/yyyy}" Width="120"/>
        </DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/><TextBlock x:Name="TxtStatus" Grid.Column="1" Foreground="{DynamicResource DevTextMuted}" FontSize="12" VerticalAlignment="Center"/><ui:Button Grid.Column="2" Content="Eliminar seleccionado" Icon="{ui:SymbolIcon Delete24}" Appearance="Caution" Click="BtnDelete_Click"/></Grid>
    </Grid>
</Page>
