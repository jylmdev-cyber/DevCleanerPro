<Page x:Class="DevCleanerPro.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dashboard">
    <ScrollViewer Margin="36,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100">

            <!-- ═══ HERO CARD (gradient left border) ═══ -->
            <Border CornerRadius="12" BorderThickness="0" Padding="0" Margin="0,0,0,20">
                <Grid>
                    <!-- Gradient left accent bar -->
                    <Border CornerRadius="12,0,0,12" Width="4" HorizontalAlignment="Left" Background="{DynamicResource DevGradientBlue}"/>
                    <!-- Card body -->
                    <Border Background="{DynamicResource DevGradientSurface}" CornerRadius="12" BorderBrush="{DynamicResource DevBorder}" BorderThickness="1" Padding="32,24" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource DevTextPrimary}" Margin="0,0,0,6">
                                    <Run Text="Bienvenido a "/><Run Text="DevCleaner Pro" Foreground="{DynamicResource DevAccentBlue}"/>
                                </TextBlock>
                                <TextBlock x:Name="TxtHeroMsg" Text="Analiza tu sistema para estimar el espacio recuperable" FontSize="13" Foreground="{DynamicResource DevTextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button x:Name="BtnQuickClean" Content="⚡ Quick Clean" Appearance="Primary" Click="BtnQuickClean_Click" FontSize="14" Padding="24,8" Margin="0,0,12,0" ToolTip="Ejecuta todos los módulos seguros (Ctrl+Shift+C)"/>
                                    <ui:Button Content="Actualizar" Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnRefresh_Click" FontSize="13" ToolTip="Refresca las métricas del dashboard"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="32,0,0,0">
                                <TextBlock x:Name="TxtHeroValue" Text="—" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource DevAccentGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="liberados en esta sesión" FontSize="11" Foreground="{DynamicResource DevTextMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ QUICK STATS (icons con fondo coloreado) ═══ -->
            <UniformGrid Columns="4" Margin="0,0,0,4">
                <!-- Último escaneo -->
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,6,10">
                    <StackPanel>
                        <Border Background="{DynamicResource DevAccentBlueDim}" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="{DynamicResource DevAccentBlue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtLastScan" Text="Nunca" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                        <TextBlock Text="ÚLTIMO ESCANEO" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <!-- Último liberado -->
                <Border Style="{StaticResource StatCardStyle}" Margin="3,0,3,10">
                    <StackPanel>
                        <Border Background="{DynamicResource DevAccentGreenDim}" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="ArrowTrendingLines24" FontSize="20" Foreground="{DynamicResource DevAccentGreen}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtFreed" Text="—" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                        <TextBlock Text="ÚLTIMO LIBERADO" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <!-- RAM Total -->
                <Border Style="{StaticResource StatCardStyle}" Margin="3,0,3,10">
                    <StackPanel>
                        <Border Background="{DynamicResource DevAccentPurpleDim}" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Memory16" FontSize="20" Foreground="{DynamicResource DevAccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtRam" Text="—" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                        <TextBlock Text="RAM TOTAL" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <!-- CPU -->
                <Border Style="{StaticResource StatCardStyle}" Margin="6,0,0,10">
                    <StackPanel>
                        <Border Background="{DynamicResource DevAccentOrangeDim}" CornerRadius="8" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="TopSpeed24" FontSize="20" Foreground="{DynamicResource DevAccentOrange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtCpu" Text="—" Style="{StaticResource StatValueStyle}" FontSize="18"/>
                        <TextBlock Text="NÚCLEOS CPU" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ SYSTEM INFO ═══ -->
            <TextBlock Text="SISTEMA" Style="{StaticResource SectionHeaderStyle}"/>
            <Border Style="{StaticResource StatCardStyle}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                <RowDefinition Height="28"/><RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sistema" Foreground="{DynamicResource DevTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtOs" Text="—" Foreground="{DynamicResource DevTextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Equipo" Foreground="{DynamicResource DevTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtMachine" Text="—" Foreground="{DynamicResource DevTextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Usuario" Foreground="{DynamicResource DevTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtUser" Text="—" Foreground="{DynamicResource DevTextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text=".NET Runtime" Foreground="{DynamicResource DevTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDotNet" Text="—" Foreground="{DynamicResource DevTextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Procesador" Foreground="{DynamicResource DevTextMuted}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtProcessor" Text="—" Foreground="{DynamicResource DevTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                    <!-- Uptime -->
                    <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UPTIME" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DevTextMuted}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtUptime" Text="—" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource DevAccentCyan}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ DRIVES ═══ -->
            <TextBlock Text="UNIDADES DE DISCO" Style="{StaticResource SectionHeaderStyle}"/>
            <ItemsControl x:Name="DrivesPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatCardStyle}" Margin="0,0,6,6">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4">
                                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource DevAccentBlue}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource DevTextMuted}" FontSize="12"/>
                                </TextBlock>
                                <ProgressBar Margin="0,6,0,8" Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="6">
                                    <ProgressBar.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#44d362" Offset="0"/>
                                            <GradientStop Color="#5ba0f5" Offset="0.6"/>
                                            <GradientStop Color="#f05555" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ProgressBar.Foreground>
                                </ProgressBar>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource DevTextMuted}" FontSize="11">
                                        <Run Text="Libre: "/><Run Text="{Binding FreeSpace, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DevTextPrimary}">
                                        <Run Text="{Binding UsagePercent, Mode=OneWay, StringFormat={}{0:F0}}"/><Run Text="%" Foreground="{DynamicResource DevTextMuted}" FontSize="11"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Loading -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,16">
                <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
