<Page x:Class="DevCleanerPro.Views.Pages.ClipboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Clipboard">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Portapapeles" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Gestión del portapapeles e historial" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource StatCardStyle}" Padding="48,32" Margin="0,0,0,16"><StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="Clipboard24" FontSize="48" Margin="0,0,0,16" HorizontalAlignment="Center"/><ui:Button Content="Vaciar portapapeles" Icon="{ui:SymbolIcon Delete24}" Appearance="Primary" Click="BtnClear_Click" HorizontalAlignment="Center" FontSize="16" Padding="32,12" Margin="0,0,0,16"/>
                <CheckBox x:Name="ChkHistory" Content="Historial del portapapeles habilitado" Click="ChkHistory_Click" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <ui:Button Content="Abrir configuración del portapapeles" Icon="{ui:SymbolIcon Settings24}" Click="BtnSettings_Click" HorizontalAlignment="Center"/>
            </StackPanel></Border>
            <TextBlock x:Name="TxtStatus" HorizontalAlignment="Center" Foreground="{DynamicResource DevTextMuted}" FontSize="13"/>
        </StackPanel>
    </Grid>
</Page>
