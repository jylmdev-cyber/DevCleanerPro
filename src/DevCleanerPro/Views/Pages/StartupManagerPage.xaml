<Page x:Class="DevCleanerPro.Views.Pages.StartupManagerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Inicio">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Programas de Inicio" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Gestiona programas que se ejecutan al iniciar Windows" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="Cargar" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Click="BtnLoad_Click" Margin="0,0,8,0"/><ui:Button Content="Deshabilitar" Icon="{ui:SymbolIcon Pause24}" Click="BtnDisable_Click" Margin="0,0,8,0"/><ui:Button Content="Habilitar" Icon="{ui:SymbolIcon Play24}" Click="BtnEnable_Click" Margin="0,0,8,0"/><ui:Button Content="Eliminar" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnDelete_Click" Margin="0,0,8,0"/><ui:Button Content="Abrir ubicación" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpen_Click"/></StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="*"/><DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="80"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsEnabled}" Width="70"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Foreground="{DynamicResource DevTextMuted}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</Page>
