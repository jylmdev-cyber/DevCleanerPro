<Page x:Class="DevCleanerPro.Views.Pages.ScheduledCleanPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Programadas">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Tareas Programadas" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Programa limpiezas automáticas con Task Scheduler" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><ui:Button Content="Crear Limpieza Diaria" Icon="{ui:SymbolIcon Calendar24}" Appearance="Primary" Click="BtnDaily_Click" Margin="0,0,8,0"/><ui:Button Content="Crear Limpieza Semanal" Icon="{ui:SymbolIcon CalendarWeekNumbers24}" Appearance="Primary" Click="BtnWeekly_Click" Margin="0,0,8,0"/><ui:Button Content="Actualizar lista" Icon="{ui:SymbolIcon ArrowSync24}" Click="BtnRefresh_Click"/></StackPanel>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="Nombre" Binding="{Binding Item1}" Width="250"/><DataGridTextColumn Header="Descripción" Binding="{Binding Item2}" Width="*"/><DataGridTextColumn Header="Próxima ejecución" Binding="{Binding Item3, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/><DataGridCheckBoxColumn Header="Activa" Binding="{Binding Item4}" Width="70"/>
        </DataGrid.Columns></DataGrid>
        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource DevTextMuted}" FontSize="12" VerticalAlignment="Center"/><ui:Button Grid.Column="1" Content="Eliminar seleccionada" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnDelete_Click"/></Grid>
    </Grid>
</Page>
