<Page x:Class="DevCleanerPro.Views.Pages.ProcessMonitorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Procesos">
    <Grid Margin="36,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Monitor de Procesos" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="Lista en tiempo real con kill, kill tree y prioridad" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtFilter" PlaceholderText="Filtrar por nombre o PID" TextChanged="TxtFilter_Changed"/><ui:Button Grid.Column="1" Content="Actualizar" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Click="BtnRefresh_Click" Margin="8,0,0,0"/>
            <ui:Button Grid.Column="2" Content="Kill" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Danger" Click="BtnKill_Click" Margin="8,0,0,0"/><ui:Button Grid.Column="3" Content="Kill Tree" Icon="{ui:SymbolIcon DismissCircle24}" Appearance="Danger" Click="BtnKillTree_Click" Margin="8,0,0,0"/></Grid>
        <DataGrid x:Name="Grid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"><DataGrid.Columns>
            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="RAM (MB)" Binding="{Binding WorkingSetMb}" Width="100"/><DataGridTextColumn Header="Ruta" Binding="{Binding FilePath}" Width="*"/><DataGridTextColumn Header="Padre" Binding="{Binding ParentPid}" Width="70"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Foreground="{DynamicResource DevTextMuted}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</Page>
